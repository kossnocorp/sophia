{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/test"
      ]
    },

    // Launch the extension in the first VS Code launch state
    {
      "name": "dev:new",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--transient",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "."
      ],
    }
  ]
}
